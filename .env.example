# JLMIRROR local development environment.
# Copy this file to `.env` and adjust values as needed.
# Never commit the real `.env` file (it is gitignored).

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + TimescaleDB)
# ---------------------------------------------------------------------------
# The docker-compose service `db` uses these. The migration role owns schemas;
# the app role is least-privilege and is constrained by RLS (ADR-003).
POSTGRES_USER=jlmirror
POSTGRES_PASSWORD=jlmirror
POSTGRES_DB=jlmirror
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# App role (least-privilege, used by the API container — must match docker/db-init/001-create-app-role.sql)
POSTGRES_APP_USER=jlmirror_app
POSTGRES_APP_PASSWORD=app_password

# Connection strings used by the application.
# - DATABASE_URL: app role (least-privilege, RLS-enforced)
# - DATABASE_MIGRATION_URL: migration/admin role (DDL + function execution)
DATABASE_URL=postgresql://jlmirror_app:app_password@localhost:5432/jlmirror
DATABASE_MIGRATION_URL=postgresql://jlmirror:jlmirror@localhost:5432/jlmirror

# ---------------------------------------------------------------------------
# API runtime
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Environment class (ADR-005): environment.development@1 | environment.validation@1 | environment.production@1
ENVIRONMENT_CLASS=environment.development@1

# ---------------------------------------------------------------------------
# Identity / Authorization (ADR-005)
# ---------------------------------------------------------------------------
# The MVP uses a local stub auth that respects the jlmirror_authority interfaces.
# To plug a real OIDC provider (e.g. Keycloak), set these and implement the
# adapter in app/auth/oidc.py.
OIDC_ISSUER=http://localhost:8080/realms/jlmirror
OIDC_CLIENT_ID=jlmirror-bff
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# Session signing secret for the BFF-managed confidential session (ADR-007).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-generate-a-real-secret

# ---------------------------------------------------------------------------
# Workers (ADR-001 — independent worker runtimes)
# ---------------------------------------------------------------------------
WORKER_VALIDATION_INTERVAL_SECONDS=30
WORKER_OUTBOX_DISPATCH_INTERVAL_SECONDS=5
WORKER_RECONCILIATION_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Zabbix provider credentials (ADR for monitoring domain)
# ---------------------------------------------------------------------------
# API token issued in Zabbix UI → Administration → API tokens.
# Used by EnvCredentialResolver (dev) and the secrets-manager adapter (prod).
ZABBIX_API_TOKEN=
# Opaque generation tag — increment when rotating the token so the platform
# knows old observations used a different key.
ZABBIX_CREDENTIAL_GENERATION_REF=cred-gen-1
