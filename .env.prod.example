# ============================================================
# JLMirror — Production environment template
# Copy to .env and fill every value before first deploy.
# Lines marked REQUIRED have no safe default.
# ============================================================

# ── Domínio público ───────────────────────────────────────────
# O domínio principal da aplicação (BFF/frontend).
# Ex: mirror.jlinformatica.com.br
PUBLIC_DOMAIN=REQUIRED_CHANGE_ME

# Domínio do Keycloak (pode ser subdomínio do mesmo servidor).
# Ex: auth.jlinformatica.com.br
KC_DOMAIN=REQUIRED_CHANGE_ME

# E-mail para notificações Let's Encrypt (Caddy ACME).
CADDY_ACME_EMAIL=REQUIRED_CHANGE_ME

# ── Database ─────────────────────────────────────────────────
# Password for jlmirror_owner (DDL/migrations) and jlmirror_app (API/BFF).
# jlmirror_worker gets its own password below.
POSTGRES_PASSWORD=REQUIRED_CHANGE_ME
DB_PASSWORD=REQUIRED_CHANGE_ME
WORKER_DB_PASSWORD=REQUIRED_CHANGE_ME

# ── Keycloak ──────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REQUIRED_CHANGE_ME
KEYCLOAK_REALM=jlmirror
# OIDC client secret — must match the value in docker/keycloak/jlmirror-realm.json
KEYCLOAK_CLIENT_SECRET=REQUIRED_CHANGE_ME

# ── Application secrets ───────────────────────────────────────
# Shared HMAC secret between BFF and API for internal calls.
BFF_INTERNAL_SECRET=REQUIRED_CHANGE_ME
# HMAC secret for notification delivery callbacks.
NOTIFICATION_CALLBACK_SECRET=REQUIRED_CHANGE_ME

# ── Application environment ───────────────────────────────────
APP_ENVIRONMENT=production
DEV_AUTH_BYPASS=false

# ── Web Push (VAPID) ─────────────────────────────────────────
# Gere com: python -c "
#   from cryptography.hazmat.primitives.asymmetric.ec import generate_private_key, SECP256R1
#   from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat, PrivateFormat, NoEncryption
#   import base64
#   k = generate_private_key(SECP256R1())
#   priv = base64.urlsafe_b64encode(k.private_bytes(Encoding.DER, PrivateFormat.PKCS8, NoEncryption())).rstrip(b'=').decode()
#   pub  = base64.urlsafe_b64encode(k.public_key().public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).rstrip(b'=').decode()
#   print('VAPID_PRIVATE_KEY=' + priv); print('VAPID_PUBLIC_KEY=' + pub)
# "
VAPID_PRIVATE_KEY=REQUIRED_CHANGE_ME
VAPID_PUBLIC_KEY=REQUIRED_CHANGE_ME
VAPID_CLAIMS_EMAIL=push@REQUIRED_CHANGE_ME

# ── OpenBao (secret store) ────────────────────────────────────
# Path to the unseal key file on the host — never commit this file.
OPENBAO_UNSEAL_KEY_PATH=./secrets/openbao/unseal.key
BAO_ADDR=http://openbao:8200
# Root token written by bao-init on first boot.
BAO_TOKEN=REQUIRED_CHANGE_ME
BAO_CACHE_SECONDS=30

# ── Provider egress ───────────────────────────────────────────
# Comma-separated hostnames the worker is allowed to reach (e.g. your Zabbix server).
EGRESS_ALLOW_HOSTS=your-zabbix-host.example.com
# Set to true only if the provider is on a private/RFC-1918 address.
EGRESS_ALLOW_PRIVATE_IPS=false
# Path to a custom CA cert for TLS verification against the provider.
PROVIDER_CA_FILE=

# ── mTLS (opt-in — leave blank to use plain HTTP internally) ──
API_MTLS=
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=
API_CA_FILE=
TLS_CERT_FILE=
TLS_KEY_FILE=
BFF_CLIENT_CERT_FILE=
BFF_CLIENT_KEY_FILE=
WORKER_CLIENT_CERT_FILE=
WORKER_CLIENT_KEY_FILE=

# ── Alerting / notifications ──────────────────────────────────
# Internal webhook URL — keep default unless you changed the API host.
ALERTING_WEBHOOK_URL=http://api:8000/dev/outbox-sink
# WhatsApp: leave blank to use the dev simulator inside BFF.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
# ITSM: leave blank to use simulated deterministic provider.
ITSM_PROVIDER_URL=

# ── Scheduler cadences (seconds) ─────────────────────────────
SCHED_PROBLEM_SECONDS=60
SCHED_CURRENT_SECONDS=300
SCHED_INVENTORY_SECONDS=1800
SCHED_METRICS_SECONDS=3600
SCHED_HISTORY_SECONDS=3600

# ── AIOps (G12) ───────────────────────────────────────────────
# Leave blank to disable AI advisory analysis.
ANTHROPIC_API_KEY=

# ── Backup (--profile backup) ─────────────────────────────────
BACKUP_INTERVAL=3600
BACKUP_RETAIN=48
BACKUP_BASEBACKUP=1

# ── Grafana (--profile observability) ────────────────────────
GF_SECURITY_ADMIN_PASSWORD=REQUIRED_CHANGE_ME
