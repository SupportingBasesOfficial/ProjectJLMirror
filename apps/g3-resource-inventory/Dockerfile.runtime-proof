ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /opt/jlmirror

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/jlmirror/src:/opt/jlmirror/apps/g3-resource-inventory

COPY src/ ./src/
COPY apps/g1-identity-tenant-shell/ ./apps/g1-identity-tenant-shell/
COPY apps/g3-resource-inventory/ ./apps/g3-resource-inventory/

EXPOSE 8446

ENTRYPOINT ["python", "apps/g3-resource-inventory/bff_server.py"]
