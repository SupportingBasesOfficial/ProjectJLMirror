{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jlmirror:contracts:source-registry:v1",
  "title": "JLMIRROR contract source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "profile_sources", "http_manifest_source", "event_manifest_source"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"const": "jlmirror.contract-source-registry@1"},
    "profile_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^docs/.+\\.md$"}
    },
    "http_manifest_source": {"$ref": "#/$defs/manifest_source"},
    "event_manifest_source": {"$ref": "#/$defs/manifest_source"}
  },
  "$defs": {
    "manifest_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "heading"],
      "properties": {
        "path": {"type": "string", "pattern": "^docs/.+\\.md$"},
        "heading": {"type": "string", "minLength": 1}
      }
    }
  }
}
