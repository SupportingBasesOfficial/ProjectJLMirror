{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G4MetricCurrentList",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_definition_id",
        "monitoring_resource_id",
        "monitoring_source_id",
        "source_instance_generation",
        "generation_state",
        "scope_state",
        "scope_evidence_state",
        "current_observation_id",
        "observed_at",
        "accepted_at",
        "value_kind",
        "value",
        "evidence_state",
        "projection_revision",
        "last_changed_at"
      ],
      "properties": {
        "metric_definition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "monitoring_resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "monitoring_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_instance_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "generation_state": {
          "enum": [
            "active_generation",
            "historical_generation"
          ]
        },
        "scope_state": {
          "enum": [
            "in_scope",
            "out_of_scope"
          ]
        },
        "scope_evidence_state": {
          "enum": [
            "current",
            "reconciliation_required"
          ]
        },
        "current_observation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_kind": {
          "enum": [
            "number",
            "integer",
            "boolean",
            "string",
            "text",
            "log"
          ]
        },
        "value": {},
        "evidence_state": {
          "enum": [
            "current",
            "stale",
            "incomplete",
            "reconciliation_required",
            "unavailable"
          ]
        },
        "projection_revision": {
          "type": [
            "integer",
            "string"
          ]
        },
        "last_changed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
