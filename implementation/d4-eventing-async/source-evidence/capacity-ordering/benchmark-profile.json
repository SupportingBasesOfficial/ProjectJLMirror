{
  "schema_version": 1,
  "profile_id": "d4-a-capacity-ordering-bounded-v1",
  "numeric_authority": "test_values_only_not_production",
  "environment_scope": "ephemeral_single_node_kraft_github_runner",
  "tiers": [
    {
      "name": "Baseline",
      "message_count": 400,
      "record_size_bytes": 256,
      "target_messages_per_second": 200,
      "tenant_weights": {"tenant-a": 80, "tenant-b": 20},
      "device_cardinality_by_tenant": {"tenant-a": 48, "tenant-b": 12},
      "partition_probe_counts": [1, 2, 4],
      "backlog_pause_seconds": 1,
      "admission": {"minimum_target_throughput_fraction": 0.70, "maximum_avg_latency_ms": 1500}
    },
    {
      "name": "Growth",
      "message_count": 1200,
      "record_size_bytes": 512,
      "target_messages_per_second": 600,
      "tenant_weights": {"tenant-a": 70, "tenant-b": 15, "tenant-c": 10, "tenant-d": 5},
      "device_cardinality_by_tenant": {"tenant-a": 120, "tenant-b": 30, "tenant-c": 20, "tenant-d": 10},
      "partition_probe_counts": [2, 4, 8],
      "backlog_pause_seconds": 2,
      "admission": {"minimum_target_throughput_fraction": 0.70, "maximum_avg_latency_ms": 1500}
    },
    {
      "name": "Stress",
      "message_count": 3000,
      "record_size_bytes": 768,
      "target_messages_per_second": 1500,
      "tenant_weights": {"tenant-a": 60, "tenant-b": 15, "tenant-c": 10, "tenant-d": 5, "tenant-e": 4, "tenant-f": 3, "tenant-g": 2, "tenant-h": 1},
      "device_cardinality_by_tenant": {"tenant-a": 360, "tenant-b": 90, "tenant-c": 60, "tenant-d": 30, "tenant-e": 24, "tenant-f": 18, "tenant-g": 12, "tenant-h": 6},
      "partition_probe_counts": [4, 8, 16],
      "backlog_pause_seconds": 3,
      "admission": {"minimum_target_throughput_fraction": 0.70, "maximum_avg_latency_ms": 1500}
    }
  ],
  "degradation_probe": {
    "mechanism": "real_kafka_client_producer_byte_rate_quota",
    "client_id": "jlmirror-d4a-quota-probe",
    "producer_byte_rate": 32768,
    "minimum_throughput_drop_fraction": 0.20,
    "meaning": "bounded_candidate_throttling_boundary_not_production_limit"
  },
  "partition_ceiling_policy": {
    "definition": "highest_tested_partition_count_sustaining_at_least_the_tier_specific_target_fraction_and_latency_admission",
    "minimum_target_throughput_fraction_meaning": "candidate_probe_must_sustain_at_least_this_fraction_of_that_same_tier_target_messages_per_second",
    "not_claimed": "absolute_cluster_or_production_partition_limit"
  },
  "ordering_scope_mappings": {
    "unordered": {"partition_key": "none", "serialization": "none"},
    "causal_only": {"partition_key": "correlation_scope_when_optimization_only", "serialization": "none"},
    "per_subject_ordered": {"partition_key": "tenant_id+subject_id", "serialization": "key_serial"},
    "per_process_ordered": {"partition_key": "tenant_id+operation_id", "serialization": "key_serial"},
    "per_source_ordered": {"partition_key": "source_identity+source_generation", "serialization": "key_serial"},
    "custom_bounded_order": {"partition_key": "trusted_contract_declared_scope", "serialization": "key_serial"}
  },
  "tenant_cohort_fallback": {
    "trigger": "exercised_logical_scope_cardinality_exceeds_single_topic_test_partition_ceiling",
    "cohort_count": 2,
    "mapping": "stable_sha256_of_trusted_tenant_identity_mod_cohort_count",
    "exercise": "generate_and_route_more_distinct_trusted_logical_scopes_than_the_stress_single_topic_test_ceiling_through_real_kafka_cohort_topics",
    "logical_contract_identity_changes": false
  },
  "required_measurements": [
    "producer_throughput_messages_per_second",
    "producer_avg_latency_ms",
    "producer_max_latency_ms",
    "backlog_messages_before_drain",
    "backlog_drain_seconds",
    "recovery_messages_per_second",
    "partition_probe_elapsed_seconds",
    "tested_partition_ceiling",
    "partition_probe_target_throughput_fraction",
    "tenant_skew_observed",
    "device_cardinality_observed_by_tenant",
    "distinct_device_scopes_observed_total",
    "degradation_boundary_observed",
    "key_serial_same_key_order_preserved",
    "independent_keys_overlap_observed",
    "tenant_cohort_fallback_exercised",
    "tenant_cohort_exercised_logical_scope_count"
  ]
}
